  "methods": [
    {
      "id": "MTH.DESC",
      "name": "Descriptive summary statistics",
      "description": "N, mean, standard deviation, median, minimum and maximum of a continuous variable, by treatment group.",
      "operations": [
        {
          "id": "OP.DESC.N",
          "order": 1,
          "name": "N"
        },
        {
          "id": "OP.DESC.MEAN",
          "order": 2,
          "name": "Mean"
        },
        {
          "id": "OP.DESC.SD",
          "order": 3,
          "name": "Standard deviation"
        },
        {
          "id": "OP.DESC.MED",
          "order": 4,
          "name": "Median"
        },
        {
          "id": "OP.DESC.MIN",
          "order": 5,
          "name": "Minimum"
        },
        {
          "id": "OP.DESC.MAX",
          "order": 6,
          "name": "Maximum"
        }
      ]
    },
    {
      "id": "MTH.FREQ",
      "name": "Categorical frequency summary",
      "description": "Count and percent of subjects in each category, by treatment group.",
      "operations": [
        {
          "id": "OP.FREQ.N",
          "order": 1,
          "name": "Count"
        },
        {
          "id": "OP.FREQ.PCT",
          "order": 2,
          "name": "Percent"
        }
      ]
    },
    {
      "id": "MTH.ANCOVA",
      "name": "ANCOVA of change from baseline with dose-response trend test",
      "description": "CHG ~ TRTP + SITEGR1 + BASE; LS-means by treatment, pairwise contrasts against placebo, and a continuous-dose trend test.",
      "operations": [
        {
          "id": "OP.ANC.LSM",
          "order": 1,
          "name": "LS mean"
        },
        {
          "id": "OP.ANC.LSMSE",
          "order": 2,
          "name": "LS mean standard error"
        },
        {
          "id": "OP.ANC.DIFF",
          "order": 3,
          "name": "LS mean difference vs placebo"
        },
        {
          "id": "OP.ANC.CI",
          "order": 4,
          "name": "95% confidence interval of the difference"
        },
        {
          "id": "OP.ANC.PVAL",
          "order": 5,
          "name": "p-value"
        },
        {
          "id": "OP.ANC.TREND",
          "order": 6,
          "name": "Dose-response trend p-value"
        }
      ]
    },
    {
      "id": "MTH.MMRM",
      "name": "Mixed model for repeated measures",
      "description": "CHG ~ TRTP + AVISIT + TRTP:AVISIT + BASE + BASE:AVISIT with unstructured covariance and Kenward-Roger degrees of freedom; observed cases only.",
      "operations": [
        {
          "id": "OP.MMRM.LSM",
          "order": 1,
          "name": "LS mean at visit"
        },
        {
          "id": "OP.MMRM.LSMSE",
          "order": 2,
          "name": "LS mean standard error"
        },
        {
          "id": "OP.MMRM.DIFF",
          "order": 3,
          "name": "LS mean difference vs placebo at Week 24"
        },
        {
          "id": "OP.MMRM.CI",
          "order": 4,
          "name": "95% confidence interval of the difference"
        },
        {
          "id": "OP.MMRM.PVAL",
          "order": 5,
          "name": "p-value"
        }
      ]
    },
    {
      "id": "MTH.INCID",
      "name": "Incidence n (%) by system organ class and preferred term",
      "description": "Number and percent of subjects with at least one event, plus event counts, by SOC and PT and treatment group.",
      "operations": [
        {
          "id": "OP.INC.N",
          "order": 1,
          "name": "Subjects with event"
        },
        {
          "id": "OP.INC.PCT",
          "order": 2,
          "name": "Percent of subjects"
        },
        {
          "id": "OP.INC.EV",
          "order": 3,
          "name": "Number of events"
        }
      ]
    },
    {
      "id": "MTH.SHIFT",
      "name": "Shift table (baseline to post-baseline category)",
      "description": "Cross-tabulation of baseline against post-baseline reference-range category, by treatment group.",
      "operations": [
        {
          "id": "OP.SH.N",
          "order": 1,
          "name": "Count"
        },
        {
          "id": "OP.SH.PCT",
          "order": 2,
          "name": "Percent"
        }
      ]
    },
    {
      "id": "MTH.SHIFTCMH",
      "name": "Shift table with Cochran-Mantel-Haenszel test",
      "description": "Shift cross-tabulation plus a CMH test across the ordered shift categories, stratified by pooled site.",
      "operations": [
        {
          "id": "OP.SHC.N",
          "order": 1,
          "name": "Count"
        },
        {
          "id": "OP.SHC.PCT",
          "order": 2,
          "name": "Percent"
        },
        {
          "id": "OP.SHC.PVAL",
          "order": 3,
          "name": "Cochran-Mantel-Haenszel p-value"
        }
      ]
    },
    {
      "id": "MTH.KM",
      "name": "Kaplan-Meier time-to-event analysis with log-rank test",
      "description": "Kaplan-Meier survival estimate by treatment group with median survival time, number at risk and a log-rank comparison.",
      "operations": [
        {
          "id": "OP.KM.MED",
          "order": 1,
          "name": "Median time to event"
        },
        {
          "id": "OP.KM.CI",
          "order": 2,
          "name": "95% confidence interval of the median"
        },
        {
          "id": "OP.KM.NEV",
          "order": 3,
          "name": "Number of events"
        },
        {
          "id": "OP.KM.NCEN",
          "order": 4,
          "name": "Number censored"
        },
        {
          "id": "OP.KM.PVAL",
          "order": 5,
          "name": "Log-rank p-value"
        }
      ]
    },
    {
      "id": "MTH.LISTING",
      "name": "Subject-level listing",
      "description": "One row per qualifying record; no summarization or inferential statistic.",
      "operations": [
        {
          "id": "OP.LST.ROW",
          "order": 1,
          "name": "Listed record"
        }
      ]
    }
